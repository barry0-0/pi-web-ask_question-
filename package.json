{
	"name": "pi-web-ask-question",
	"version": "1.0.0",
	"private": true,
	"description": "Pi Web ask_user_question plugin: in-flow rich cards, radio/checkbox options, back/next navigation, and automatic host patching across pi-web versions.",
	"type": "module",
	"exports": {
		".": "./index.ts",
		"./events": "./events.ts"
	},
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/barry0-0/pi-web-ask_question-.git"
	},
	"peerDependencies": {
		"@juicesharp/rpiv-i18n": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"peerDependenciesMeta": {
		"@juicesharp/rpiv-i18n": {
			"optional": true
		}
	},
	"dependencies": {
		"@juicesharp/rpiv-config": "^2.15.0"
	}
}
